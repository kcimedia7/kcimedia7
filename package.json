{
  "name": "splatworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn photos and videos into 3D Gaussian Splats, then view and edit them in a library.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:ops": "bash ops/tests/test_ops.sh",
    "test:all": "npm test && npm run test:ops",
    "doctor": "node ops/local/claude-local.mjs doctor",
    "host": "node ops/local/claude-local.mjs up",
    "host:lan": "node ops/local/claude-local.mjs up --lan",
    "stop": "node ops/local/claude-local.mjs down",
    "status": "node ops/local/claude-local.mjs status"
  }
}
